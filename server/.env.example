MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
PORT=4000
# Signiert die Login-Tokens. Zufälligen, langen Wert erzeugen, z. B.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Google-Anmeldung für GÄSTE (optional). OAuth-Client-ID vom Typ "Web" aus der
# Google Cloud Console; die Frontend-Adresse muss dort unter "Authorized
# JavaScript origins" stehen (z. B. http://localhost:5173).
# Ohne Wert bleibt der Google-Knopf aus, E-Mail mit Passwort funktioniert.
GOOGLE_CLIENT_ID=
