MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
PORT=4000
# Signiert die Login-Tokens. Zufälligen, langen Wert erzeugen, z. B.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Google-Anmeldung für GÄSTE (optional). OAuth-Client-ID vom Typ "Web" aus der
# Google Cloud Console; die Frontend-Adresse muss dort unter "Authorized
# JavaScript origins" stehen (z. B. http://localhost:5173).
# Ohne Wert bleibt der Google-Knopf aus, E-Mail mit Passwort funktioniert.
GOOGLE_CLIENT_ID=
# KI-Funktionen (optional): der fertig formulierte Rezensionstext auf dem
# Dank-Bildschirm, der Wochenrückblick im Dashboard und der Bon-Scan der
# Servicekraft. Schlüssel aus der Anthropic Console.
# Ohne Wert bleiben Rezensionstext und Rückblick bei einer gerechneten Vorlage,
# und der Bon-Scan meldet, dass er nicht eingerichtet ist. Alles andere
# funktioniert unverändert.
ANTHROPIC_API_KEY=
# Verschlüsselt private Anthropic-Schlüssel, die Gäste und Personal in ihrem
# eigenen Konto hinterlegen können (server/src/secrets.ts, AES-256-GCM).
# Zufälligen, langen Wert erzeugen, z. B.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ohne Wert bleibt das Hinterlegen eines eigenen Schlüssels ausgeschaltet
# (503) — der gemeinsame ANTHROPIC_API_KEY (falls gesetzt) und die
# Vorlagen-Notausgänge funktionieren unverändert. Wird der Wert später
# geändert, lassen sich zuvor gespeicherte Schlüssel nicht mehr entschlüsseln.
API_KEY_ENC_SECRET=
